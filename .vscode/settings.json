{
    // VSCodium é Flatpak: o LaTeX roda no sistema (host) via flatpak-spawn
    "latex-workshop.latex.tools": [
        {
            "name": "compilar.sh",
            "command": "flatpak-spawn",
            "args": ["--host", "bash", "%DIR%/compilar.sh"],
            "env": {}
        }
    ],
    "latex-workshop.latex.recipes": [
        {
            "name": "compilar.sh",
            "tools": ["compilar.sh"]
        }
    ],
    "latex-workshop.latex.recipe.default": "first",
    "latex-workshop.latex.autoBuild.run": "onSave",
    // O próprio compilar.sh já remove os arquivos auxiliares
    "latex-workshop.latex.autoClean.run": "never"
}
